   1          #include "timer0.h"
   2          #include "config.h"
   3          
   4          /*********************************************
   5          /*函数名称：Timer0_Config(u8 mode, u16 time)
   6          /*函数功能：Timer0配置函数
   7          /*输入参数：mode:速度模式
   8          /*          mode=1, 1T模式; mode=2,12T模式
   9          /*          time:定时时间
  10          /*  1T模式(max=5.9ms):1ms=1000,2ms=500,5ms=200
  11          /*  12T模式(max=71ms):1ms=1000,10ms=100
  12          /*返回值：无
  13          *********************************************/
  14          void Timer0_Config(u8 mode, u16 time)
  15          {
  16   1        switch(mode)
  17   1        {
  18   2          case STC_1T:
  19   2          {
  20   3            AUXR |= 0x80;   //定时器0为1T模式
  21   3            TH0 = (65536-MAIN_Fosc/time)/256;
  22   3            TL0 = (65536-MAIN_Fosc/time)%256;
  23   3          }
  24   2          break;
  25   2          case STC_12T:
  26   2          {
  27   3            AUXR &= ~0x80;  //定时器0为12T模式
  28   3            TH0 = (65536-MAIN_Fosc/time/12)/256;
  29   3            TL0 = (65536-MAIN_Fosc/time/12)%256;
  30   3          }
  31   2        }
  32   1        TMOD &= 0xF0;   //设置定时器为模式0,16位自动重装载
  33   1        TF0 = 0;        //清除可能残留的溢出标志
  34   1        TR0 = 1;        //启动定时器
  35   1        ET0 = 1;        //打开定时器中断
  36   1        PX0 = 0;
  37   1        IP &= ~(0x01 << 1);
  38   1        IPH &= ~(0x01 << 1);
  39   1      }
