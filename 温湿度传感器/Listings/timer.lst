line level    source

   1          #include <STC8H.H>
   2          #include "timer.h"
   3          #include "task.h"
   4          #include "digital_tube.h"
   5          
   6          /*
   7           * 定时器0 配置（@11.0592MHz，1T模式，模式0 16位自动重载）
   8           * 重载值 = 65536 - 11059200 / 1000 = 65536 - 11059 = 54477 = 0xD4CD
   9           * 定时周期：1ms（≈0.9999ms，误差 0.0018%，可忽略）
  10           */
  11          #define TIMER0_RELOAD  0xD4CD
  12          
  13          /* 各任务计数器定义 */
  14          unsigned int cnt_10ms   = 0;
  15          unsigned int cnt_50ms   = 0;
  16          unsigned int cnt_100ms  = 0;
  17          unsigned int cnt_500ms  = 0;
  18          unsigned int cnt_1000ms = 0;
  19          
  20          /* 定时器0初始化 */
  21          void Timer0_Init(void)
  22          {
  23   1          AUXR |= 0x80;               /* 定时器0 选择 1T 模式（不分频） */
  24   1          TMOD &= 0xF0;               /* 定时器0 工作在模式0（16位自动重载） */
  25   1          TL0 = TIMER0_RELOAD & 0xFF; /* 加载重载值低字节 */
  26   1          TH0 = TIMER0_RELOAD >> 8;   /* 加载重载值高字节 */
  27   1          TF0 = 0;                    /* 清除溢出标志 */
  28   1          ET0 = 1;                    /* 使能定时器0中断 */
  29   1          TR0 = 1;                    /* 启动定时器0 */
  30   1      }
  31          
  32          /* 定时器0中断服务函数（每 1ms 触发一次） */
  33          void Timer0_ISR(void) interrupt 1
  34          {
  35   1          DigitalTube_Scan1ms();
  36   1          Task_1ms();     /* 1ms 任务：直接在中断中执行，响应最及时 */
  37   1          cnt_10ms++;
  38   1          cnt_50ms++;
  39   1          cnt_100ms++;
  40   1          cnt_500ms++;
  41   1          cnt_1000ms++;
  42   1      }


