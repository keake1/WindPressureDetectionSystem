  77          
  78          void DigitalTube_SetValue(int value_x10)
  79          {
  80   1          unsigned int magnitude;
  81   1      
  82   1          if(value_x10 < 0)
  83   1          {
  84   2              magnitude = (unsigned int)(-value_x10);
  85   2              if(magnitude > 99U)
  86   2              {
  87   3                  magnitude = 99U;       /* 三位仅可显示到 -9.9。 */
  88   3              }
  89   2      
  90   2              s_digits[0] = DIGIT_MINUS;
  91   2              s_digits[1] = (unsigned char)(magnitude / 10U);
  92   2              s_digits[2] = (unsigned char)(magnitude % 10U);
  93   2          }
  94   1          else
  95   1          {
  96   2              magnitude = (unsigned int)value_x10;
  97   2              if(magnitude > 999U)
  98   2              {
  99   3                  magnitude = 999U;      /* 正值超量程显示为 99.9。 */
 100   3              }
 101   2      
 102   2              s_digits[0] = (magnitude >= 100U) ? (unsigned char)(magnitude / 100U) : DIGIT_BLANK;
 103   2              s_digits[1] = (unsigned char)((magnitude / 10U) % 10U);
 104   2              s_digits[2] = (unsigned char)(magnitude % 10U);
 105   2          }
 106   1      }
