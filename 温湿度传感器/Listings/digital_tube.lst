  60          void DigitalTube_Init(void)
  61          {
  62   1          /* 三个位选。 */
  63   1          P0M1 &= ~0x02U;
  64   1          P0M0 |=  0x02U;
  65   1          P2M1 &= ~0x48U;
  66   1          P2M0 |=  0x48U;
  67   1      
  68   1          /* 七段和小数点。 */
