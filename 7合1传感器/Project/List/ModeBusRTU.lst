 190          void parse_co2_frame()
 191          {
 192   1          co2.valid = 0;
 193   1      
 194   1          // -------------------------
 195   1          // 主动输出帧 (16 bytes)
 196   1          // -------------------------
 197   1          if (pRxPacket == 16 && sensorRawData[0] == 0x42 && sensorRawData[1] == 0x4D)
 198   1          {
 199   2              uint8_t sum = calc_sum_check(sensorRawData, 16);
 200   2              if (sum == sensorRawData[15])
 201   2              {
 202   3                  co2.co2_ppm = (sensorRawData[6] << 8) | sensorRawData[7];
 203   3                  co2.valid = 1;
 204   3                  co2.mode = 1;  // 主动输出模式
 205   3              }
 206   2              else
 207   2              {
 208   3            return;
 209   3              }
 210   2          }
 211   1      
 212   1          // -------------------------
 213   1          // 查询返回帧 (14 bytes)
 214   1          // -------------------------
 215   1          else if (pRxPacket == 14 && sensorRawData[0] == 0x64 && sensorRawData[1] == 0x69)
 216   1          {
 217   2              // 提取CRC
 218   2              uint16_t crc_calc = calc_sum_check(sensorRawData, 12);
 219   2              uint16_t crc_recv = (sensorRawData[13] << 8) | sensorRawData[12];
 220   2      
 221   2              if (crc_calc == crc_recv)
 222   2              {
 223   3                  co2.co2_ppm = (sensorRawData[5] << 8) | sensorRawData[4];
 224   3                  co2.valid = 1;
 225   3                  co2.mode = 2;  // 查询返回模式
 226   3              }
 227   2              else
 228   2              {
 229   3            return;
 230   3              }
 231   2          }
 232   1          else
 233   1          {
 234   2          return;
 235   2          }
 236   1      
 237   1      }
 238          unsigned int parse_sensor_frame() {
 239   1      // 温度部分
 240   1          uint8_t temp_high = sensorRawData[12];
C51 COMPILER V9.60.7.0   MODEBUSRTU                                                        07/26/2026 15:50:15 PAGE 5   

 241   1          uint8_t temp_low  = sensorRawData[13];
 242   1        uint8_t checksum = calc_checksum(sensorRawData, sizeof(sensorRawData));
 243   1        
 244   1        float temp = (float)temp_high + (temp_low / 10.0f);
 245   1          if (sizeof(sensorRawData) < 17 || sensorRawData[0] != 0x3C || sensorRawData[1] != 0x02) {
 246   2              sensor.valid = 0;
 247   2              pRxPacket=0;
 248   2              return 0;
 249   2          }
 250   1      
 251   1          if (checksum != sensorRawData[16]) {
 252   2              sensor.valid = 0;
 253   2              pRxPacket=0;
 254   2              return 0;
 255   2          }
 256   1          
 257   1          sensor.valid = 1;
 258   1          // 解析各项数据（高字节在前）
 259   1          sensor.eCO2  = (sensorRawData[2] << 8) | sensorRawData[3];
 260   1          sensor.eCH2O = (sensorRawData[4] << 8) | sensorRawData[5];
 261   1          sensor.TVOC  = (sensorRawData[6] << 8) | sensorRawData[7];
 262   1          sensor.PM2_5 = (sensorRawData[8] << 8) | sensorRawData[9];
 263   1          sensor.PM10  = (sensorRawData[10] << 8) | sensorRawData[11];
 264   1          
 265   1          
 266   1          
 267   1          if (temp_high & 0x80) { // bit7=1 表示负温度
 268   2              temp_high &= 0x7F;
 269   2              temp = -((float)temp_high + (temp_low / 10.0f));
 270   2          }
 271   1          sensor.Temperature = temp*10;
 272   1          // 湿度部分
 273   1          sensor.Humidity = (sensorRawData[14] + (sensorRawData[15] / 10.0f)) * 10;
 274   1          pRxPacket=0;
 275   1          return sensor.Humidity;
 276   1      }
