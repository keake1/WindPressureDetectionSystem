  63   1      }
  64          uint16_t ModBus_CRC(uint8_t *addr,uint8_t num)
  65          {
  66   1        
  67   1        int i, j, temp;
  68   1        
  69   1        uint16_t crc=0xFFFF;  
  70   1        EA = 0;
  71   1        for(i = 0; i < num; i++) {
  72   2          crc = crc ^ (*addr);
  73   2          for( j = 0; j < 8; j++)
  74   2          {
  75   3            temp = crc & 0x0001;
  76   3            crc = crc>>1;
  77   3            if(temp) {
  78   4              crc = crc ^ 0xA001;
  79   4            }
  80   3          }
  81   2          addr++;
  82   2        }
  83   1        EA = 1;
  84   1        return crc;
  85   1      }
