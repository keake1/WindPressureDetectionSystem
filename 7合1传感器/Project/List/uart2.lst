  37          //========================================================================
  38          // 函数: void UART2_config(u8 UART_IOSEL,u32 FOSC,u32 BAUD2)
  39          // 描述: UART2初始化函数
  40          // 参数: FOSC:设置晶振时钟频率，BAUD2:设置波特率
  41          //       UART_IOSEL=0x00:P1.0/P1.1
  42          // 返回: none
  43          // 备注: 
  44          //========================================================================
  45          void UART2_config(u8 UART_IOSEL,u32 FOSC,u32 BAUD2)
  46          {
  47   1        AUXR &= ~(1<<4);    //Timer stop
  48   1        AUXR &= ~(1<<3);    //Timer2 set As Timer
  49   1        AUXR |=  (1<<2);    //Timer2 set as 1T mode
  50   1        T2H = (65536UL - (FOSC / 4) / BAUD2) / 256;
  51   1        T2L = (65536UL - (FOSC / 4) / BAUD2) % 256;
  52   1        IE2  &= ~(1<<2);    //禁止中断
  53   1        AUXR |=  (1<<4);    //Timer run enable
  54   1        S2CON &= ~(1<<7);   // 8位数据, 1位起始位, 1位停止位, 无校验
