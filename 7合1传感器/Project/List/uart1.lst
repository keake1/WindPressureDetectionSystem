  40          // 函数: void UART1_config(u8 UART_IOSEL,u32 FOSC,u32 BAUD1)
  41          // 描述: UART1初始化函数
  42          // 参数: FOSC:设置晶振时钟频率，BAUD1:设置波特率
  43          //       UART_IOSEL=0x00:P3.0/P3.1
  44          //       UART_IOSEL=0x40:P3.2/P3.3
  45          //       UART_IOSEL=0x80:P5.4/P5.5
  46          // 返回: none
  47          // 备注: 
  48          //========================================================================
  49          void UART1_config(u8 UART_IOSEL,u32 FOSC,u32 BAUD1)
  50          {
  51   1        TR1 = 0;
  52   1        AUXR &= ~0x01;      //S1 BRT Use Timer1;
  53   1        AUXR |=  (1<<6);    //Timer1 set as 1T mode
  54   1        TMOD &= ~(1<<6);    //Timer1 set As Timer
C51 COMPILER V9.60.7.0   UART1                                                             07/26/2026 15:50:14 PAGE 2   

  55   1        TMOD &= ~0x30;      //Timer1_16bitAutoReload;
  56   1        TH1 = (u8)((65536UL - (FOSC / 4) / BAUD1) / 256);
  57   1        TL1 = (u8)((65536UL - (FOSC / 4) / BAUD1) % 256);
  58   1        ET1 = 0;    //禁止中断
  59   1        TR1  = 1;
  60   1        SCON = (SCON & 0x3f) | 0x40;    //UART1模式, 0x00: 同步移位输出, 0x40: 8位数据,可变波特率
             -, 0x80: 9位数据,固定波特率, 0xc0: 9位数据,可变波特率
  61   1          PS  = 1;    //高优先级中断
  62   1        IPH  |=  0x01 << 4;
  63   1        ES  = 1;    //允许中断
  64   1        REN = 1;    //允许接收
  65   1        P_SW1 |= UART_IOSEL;
  66   1        //  PCON2 |=  (1<<4);   //内部短路RXD与TXD, 做中继, ENABLE,DISABLE
  67   1        B_TX1_Busy = 0;
  68   1        TX1_Cnt = 0;
  69   1        RX1_Cnt = 0;
  70   1      }
