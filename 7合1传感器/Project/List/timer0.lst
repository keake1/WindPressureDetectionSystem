   1          #include "timer0.h"
   2          #include "config.h"
   3          
   4          //
   5          u16 T0_cnt;
   6          
   7          /*********************************************
   8          /*函数名称：Timer0_Config(u8 mode, u16 time)
   9          /*函数功能：Timer0配置函数
  10          /*输入参数：mode:速度模式
  11          /*          mode=1, 1T模式; mode=2,12T模式
  12          /*          time:定时时间
  13          /*  1T模式(max=5.9ms):1ms=1000,2ms=500,5ms=200
  14          /*  12T模式(max=71ms):1ms=1000,10ms=100
  15          /*返回值：无
  16          *********************************************/
  17          void Timer0_Config(u8 mode, u16 time)
  18          {
  19   1        switch(mode)
  20   1        {
  21   2          case STC_1T:
  22   2          {
  23   3            AUXR |= 0x80;   //定时器0为1T模式
  24   3            TH0 = (65536-MAIN_Fosc/time)/256;
  25   3            TL0 = (65536-MAIN_Fosc/time)%256;
  26   3          }
  27   2          break;
  28   2          case STC_12T:
  29   2          {
  30   3            AUXR &= ~0x80;  //定时器0为12T模式
  31   3            TH0 = (65536-MAIN_Fosc/time/12)/256;
  32   3            TL0 = (65536-MAIN_Fosc/time/12)%256;
  33   3          }
  34   2        }
  35   1        TMOD &= 0xF0;   //设置定时器为模式0,16位自动重装载
  36   1        TR0 = 1;        //启动定时器
  37   1        ET0 = 1;        //打开定时器中断
  38   1        PX0 = 0;
  39   1        IP &= ~(0x01) << 1;
  40   1        IPH &= ~(0x01) << 1;
  41   1      }
